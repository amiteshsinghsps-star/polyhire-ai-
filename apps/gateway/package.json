{
  "name": "@polyhire/gateway",
  "version": "1.0.0",
  "private": true,
  "description": "PolyHire AI — API Gateway (Node.js + Express + Socket.IO)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@polyhire/shared-types": "workspace:*",
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "morgan": "^1.10.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.0",
    "eslint": "^8.57.0",
    "rimraf": "^5.0.5",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5"
  }
}
