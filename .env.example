# =============================================================================
# PolyHire AI — Environment Configuration Template
# Copy to `.env` and fill in real values. NEVER commit real keys.
#
# PolyHire AI runs 100% CPU-only — no GPU, no paid APIs required.
# All stages have deterministic fallbacks: zero-setup, fully offline.
# =============================================================================

# --- Service URLs (used between Gateway <-> ML Service) ---
ML_SERVICE_URL=http://localhost:8000
GATEWAY_URL=http://localhost:4000

# --- Service ports ---
ML_SERVICE_PORT=8000
GATEWAY_PORT=4000
FRONTEND_PORT=5173

# --- Vector DB mode ---
# "memory" = in-process FAISS (no external DB needed, default)
# "faiss"  = same as memory — FAISS is always the CPU backend
QDRANT_MODE=memory

# --- Feature flags (toggle bonus features without redeploying) ---
ENABLE_VOICE_INPUT=true
ENABLE_HINDI_TRANSLATION=true
ENABLE_BIAS_DETECTION=true
ENABLE_SKILL_GAP_REPORTS=true
ENABLE_ANOMALY_DETECTION=true
ENABLE_LLM_EXPLAINABILITY=true

# --- Bharat Intelligence Layer ---
ENABLE_BHARAT_INTELLIGENCE=true
ENABLE_INDICTRANS2=false
BHARAT_TIER_OVERRIDE=auto

# --- Retrieval hyperparameters ---
RETRIEVAL_TOP_K=100
RERANK_TOP_K=30
SHORTLIST_SIZE=20
NEAR_MISS_BAND_SIZE=20

# --- Submission Mode (Redrob Hackathon — polyhire-redrob/rank.py) ---
SUBMISSION_MODE=false
SUBMISSION_TOP_K=100
SUBMISSION_CANDIDATES_PATH=polyhire-redrob/data/candidates.jsonl
SUBMISSION_OUTPUT_PATH=polyhire-redrob/team_xcution.csv
